<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
  <!--
    Used when the macOS build is signed with the hardened runtime. The first
    three match electron-builder's defaults for Electron and native modules
    (node-pty, sherpa-onnx); audio-input lets the hardened runtime open the
    microphone for local dictation (the user still grants access through the
    NSMicrophoneUsageDescription prompt).
  -->
  <dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
  </dict>
</plist>
